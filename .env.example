# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# --- SAP (SQL Server) ---
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_CERT=yes

# --- Microsoft Graph (solo para el envío por correo de main.py) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=
MAIL_TO=correo1@empresa.com,correo2@empresa.com

# --- Zoho CRM / Campaigns ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CRM_VERSION=v7
ZOHO_ORIGENES_CAMPANA=Email marketing
ZOHO_ETAPAS_GANADA=Cerrado Ganado
ZOHO_ETAPAS_PERDIDA=Cerrado Perdido
ZOHO_CAMPO_MOTIVO=Reason_For_Loss__s

# --- Dashboard web ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=
DASHBOARD_CACHE_MIN=5
# 0 en localhost, 1 en el servidor con HTTPS
DASHBOARD_HTTPS=0
# Genera cada usuario con: python crear_usuario.py nombre  (separa varios con coma)
DASHBOARD_USUARIOS=
